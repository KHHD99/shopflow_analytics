[0m20:00:20.476015 [debug] [Thread-5 (]: On model.shopflow_analytics.int_order_items_with_product: /* {"app": "dbt", "dbt_version": "1.12.0", "dbt_databricks_version": "1.12.3", "databricks_sql_connector_version": "4.3.0", "profile_name": "shopflow_analytics", "target_name": "dev", "invocation_id": "5cba78ba-82a4-4c94-a500-69b4aea3ba64", "node_id": "model.shopflow_analytics.int_order_items_with_product"} */

  
  
  
  create or replace view `shopflow_analytics_cat`.`silver`.`int_order_items_with_product`
  
  as (
    -- One row per order line with product and order context
with order_items as (
    select * from `shopflow_analytics_cat`.`silver`.`stg_order_items`
),

products as (
    select * from `shopflow_analytics_cat`.`silver`.`stg_products`
),

orders as (
    select order_id, customer_id, order_date, status
    from `shopflow_analytics_cat`.`silver`.`stg_orders`
),

joined as (
    select
        order_items.order_item_id,
        order_items.order_id,
        order_items.product_id,
        order_items.quantity,
        order_items.unit_price,
        (order_items.quantity * order_items.unit_price) as line_total,
        products.product_name,
        products.category as product_category,
        products.price as product_current_price,
        orders.customer_id,
        orders.order_date,
        orders.status as order_status
    from order_items
    left join products on order_items.product_id = products.product_id
    left join orders on order_items.order_id = orders.order_id
)

select * from joined
  )

